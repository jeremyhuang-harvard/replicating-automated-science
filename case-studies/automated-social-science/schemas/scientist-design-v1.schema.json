{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/assr/scientist-design-v1.schema.json",
  "title": "Scientist Design v1",
  "type": "object",
  "required": ["schema_version", "scenario", "agents", "outcome", "causes", "information_scope", "interaction"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "scientist-design-v1"},
    "scenario": {"type": "string", "minLength": 1},
    "agents": {
      "type": "array", "minItems": 1, "maxItems": 4,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "role", "goal", "constraints"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "goal": {"type": "string", "minLength": 1},
          "constraints": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "outcome": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "operationalization", "measurement_question", "respondent"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "operationalization": {"type": "string", "minLength": 1},
        "measurement_question": {"type": "string", "minLength": 1},
        "respondent": {"type": "string", "minLength": 1}
      }
    },
    "causes": {
      "type": "array", "minItems": 1, "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "hypothesis", "predicted_direction", "treatment_values"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "hypothesis": {"type": "string", "minLength": 1},
          "predicted_direction": {"enum": ["increase", "decrease", "non_monotonic", "uncertain"]},
          "treatment_values": {"type": "array", "minItems": 2, "maxItems": 3, "uniqueItems": true, "items": {"type": ["string", "number", "boolean"]}}
        }
      }
    },
    "information_scope": {
      "type": "object", "additionalProperties": false,
      "required": ["public", "private"],
      "properties": {
        "public": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "private": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["agent", "information"],
            "properties": {
              "agent": {"type": "string", "minLength": 1},
              "information": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
            }
          }
        }
      }
    },
    "interaction": {
      "type": "object", "additionalProperties": false,
      "required": ["order", "max_turns", "stopping_rule"],
      "properties": {
        "order": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "max_turns": {"type": "integer", "minimum": 1, "maximum": 8},
        "stopping_rule": {"type": "string", "minLength": 1}
      }
    }
  }
}
