{
  "agents": [
    {
      "constraints": [
        "must accept a price above $5"
      ],
      "goal": "maximize profit from the sale",
      "name": "Alice",
      "role": "seller"
    },
    {
      "constraints": [
        "must offer at least $3"
      ],
      "goal": "minimize cost of the mug",
      "name": "Bob",
      "role": "buyer"
    }
  ],
  "causes": [
    {
      "hypothesis": "A higher initial offer by Alice increases the final price",
      "name": "initial offer",
      "predicted_direction": "increase",
      "treatment_values": [
        "$10",
        "$8",
        "$6"
      ]
    },
    {
      "hypothesis": "A lower counteroffer by Bob decreases the final price",
      "name": "counteroffer",
      "predicted_direction": "decrease",
      "treatment_values": [
        "$4",
        "$5",
        "$7"
      ]
    },
    {
      "hypothesis": "Higher mug quality increases the final price",
      "name": "mug quality",
      "predicted_direction": "increase",
      "treatment_values": [
        "vintage",
        "standard",
        "broken"
      ]
    }
  ],
  "information_scope": {
    "private": [
      {
        "agent": "Alice",
        "information": [
          "initial offer",
          "mug quality"
        ]
      },
      {
        "agent": "Bob",
        "information": [
          "counteroffer",
          "mug quality"
        ]
      }
    ],
    "public": [
      "mug quality"
    ]
  },
  "interaction": {
    "max_turns": 2,
    "order": [
      "Alice",
      "Bob"
    ],
    "stopping_rule": "when both agents agree on a price"
  },
  "outcome": {
    "measurement_question": "What was the final price agreed upon?",
    "name": "final price",
    "operationalization": "the price agreed upon by Alice and Bob",
    "respondent": "both agents"
  },
  "scenario": "two people bargaining over a mug",
  "schema_version": "scientist-design-v1"
}
